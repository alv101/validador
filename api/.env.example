# API
PORT=3000
JWT_SECRET=change_me_long_random_secret

# CORS
# Lista separada por comas. En produccion no dejar vacio.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres (validaciones)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=validador_db
DB_USER=validador_user
DB_PASS=change_me_db_password

# Catalogo de servicio (ticketing)
# fake: devuelve datos simulados
# sqlserver: obliga a implementar consultas reales en service-catalog.service.ts
TICKETING_CATALOG_MODE=fake

# Adapter de validacion de tickets:
# - fake: validacion simulada (default)
# - sqlserver: usa TicketingSqlServerAdapter con SQL TODO(TICKETING_DB)
TICKETING_ADAPTER_MODE=fake

# TODO(TICKETING_DB): completar cuando implementes conexion real a SQL Server 2005
TICKETING_DB_HOST=192.168.200.3
TICKETING_DB_INSTANCE=server2003
TICKETING_DB_PORT=1433
TICKETING_DB_NAME=ticketing_db
TICKETING_DB_USER=ticketing_user
TICKETING_DB_PASS=change_me_ticketing_password
TICKETING_DB_CONNECT_TIMEOUT_MS=15000
TICKETING_DB_REQUEST_TIMEOUT_MS=20000
TICKETING_DB_POOL_MAX=5
TICKETING_DB_IDLE_TIMEOUT_MS=30000
# Solo para desarrollo: habilita logs de SQL/params enmascarados.
# En produccion mantener en false/no definido.
TICKETING_SQL_DEBUG=false

# Fuente para validate-locator:
# - ticketing: valida contra TicketingAdapter (recomendado)
# - local: usa tabla locator_tickets local (modo legacy)
VALIDATE_LOCATOR_SOURCE=ticketing

# Reset administrativo de validaciones (peligroso)
VALIDATIONS_RESET_ENABLED=false
# Solo si publicas en internet y necesitas habilitarlo en prod.
ALLOW_VALIDATIONS_RESET_IN_PROD=false
# Habilita explicitamente el boton de reset en UI. Recomendado false.
VALIDATIONS_RESET_UI_ENABLED=false
# Clave obligatoria por header x-reset-admin-key cuando se habilita en prod.
VALIDATIONS_RESET_ADMIN_KEY=change_me_reset_key
